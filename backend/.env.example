# Em NODE_ENV=production/staging o servidor NÃO inicia com valores fracos ou padrão (veja docs/operacao.md):
# JWT_SECRET aleatório com 32+ caracteres, URLs https reais, SMTP configurado e TRUST_PROXY explícito.
NODE_ENV=development
PORT=3333
DATABASE_URL=./argos.sqlite
# Gere com: openssl rand -base64 48   (nunca versione o valor real)
JWT_SECRET=change-me-in-production
# Formato <número><s|m|h|d>. Access: 1m a 24h. Refresh: 1h a 90d.
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d
# Origens exatas (esquema://host[:porta]) separadas por vírgula; sem curinga.
CORS_ORIGINS=http://localhost:5173
API_PUBLIC_URL=http://localhost:3333
FRONTEND_URL=http://localhost:5173
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5
ADMIN_EMAIL=admin@argos.local
# Só é usada para criar o administrador inicial. Em produção: 12+ caracteres, 3 tipos, sem "admin/argos/senha".
# Depois do primeiro boot pode ser removida do ambiente.
ADMIN_PASSWORD=<defina-uma-senha-forte>
# Opcional (somente NODE_ENV=development): conta citizen de teste.
DEV_TEST_USER_PASSWORD=
# Proxy reverso: false (acesso direto), número de saltos (ex.: 1) ou IPs/CIDRs do proxy (ex.: 10.0.0.0/8).
# "true" não é aceito em produção (confiaria em qualquer X-Forwarded-For).
TRUST_PROXY=false
# Cookie de sessão: lax (padrão; web e API no mesmo site, via proxy /api). none só com HTTPS e se houver
# requisito de domínios cruzados (requisições de outras origens continuam bloqueadas pela verificação de Origin).
COOKIE_SAMESITE=lax
# Validade do link de confirmação de e-mail do cadastro por senha (horas).
EMAIL_VERIFICATION_TTL_HOURS=24
# Retenção em dias (0 = não expurgar). Valores padrão provisórios: aprovar com o responsável pela privacidade.
MAIL_OUTBOX_RETENTION_DAYS=30
AUTH_TOKEN_RETENTION_DAYS=30
ACCESS_REQUEST_RETENTION_DAYS=180
AUDIT_LOG_RETENTION_DAYS=0
# Cópia automática do banco antes de aplicar migrações (padrão: ligado fora de testes; pasta: <banco>/backups).
MIGRATION_BACKUP=true
MIGRATION_BACKUP_DIR=
# ── E-mail (SMTP) ─ obrigatório em produção/homologação. Em desenvolvimento, sem SMTP_HOST, o terminal mostra
# só destinatário mascarado e assunto; links de confirmação e de senha NUNCA são impressos. Para testar links
# localmente, use um capturador SMTP (ex.: Mailpit: SMTP_HOST=localhost SMTP_PORT=1025, sem usuário/senha).
# Gmail:  SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_USER=voce@gmail.com  SMTP_PASS=<senha de app de 16 letras>
#         (a senha de app exige verificação em duas etapas: myaccount.google.com/apppasswords)
# Brevo:  SMTP_HOST=smtp-relay.brevo.com  SMTP_PORT=587  SMTP_USER=<login SMTP do painel>  SMTP_PASS=<chave SMTP>
# Resend: SMTP_HOST=smtp.resend.com  SMTP_PORT=465  SMTP_USER=resend  SMTP_PASS=<API key re_...>
# Teste no painel Administração > "Testar e-mail".
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=ARGOS <no-reply@argos.local>

# ── Mapa (Leaflet + OpenStreetMap, sem chave) ─ centro do campus e zoom inicial.
MAP_CENTER_LAT=-23.5505
MAP_CENTER_LNG=-46.6333
MAP_ZOOM=16

# ── IA com visão (Claude API) ─ chave em console.anthropic.com > API Keys. Sem chave, o botão some.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# ── Tradução automática das publicações ─ DeepL (chave grátis em deepl.com/pro-api, termina em :fx)
# ou LibreTranslate (ex.: docker run -p 5000:5000 libretranslate/libretranslate e LIBRETRANSLATE_URL=http://localhost:5000).
DEEPL_API_KEY=
LIBRETRANSLATE_URL=
LIBRETRANSLATE_API_KEY=

# ── Login com Google ─ console.cloud.google.com > APIs e serviços > Credenciais > ID do cliente OAuth (Aplicativo da Web),
# com "Origens JavaScript autorizadas" = http://localhost:5173 (e o endereço público do site).
GOOGLE_CLIENT_ID=

# ── CAPTCHA Cloudflare Turnstile ─ dash.cloudflare.com > Turnstile. Chaves de teste que sempre passam:
# TURNSTILE_SITE_KEY=1x00000000000000000000AA  TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Notificações push no navegador (Web Push) ─ opcional: sem chaves, o servidor gera um par e guarda no banco.
# Para gerar: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@argos.local

# ── Publicação ─ pasta do build da web (frontend/dist). Definida, a API também serve o site no mesmo domínio
# (prévias de link, robots.txt, sitemap.xml, CSP e compressão). A imagem Docker já define /app/web.
WEB_DIST_DIR=
# E-mail público de atendimento, exibido no rodapé e em "Como funciona". Vazio: o contato não aparece.
SUPPORT_EMAIL=
