# Configuração do ARGOS no servidor. O instalar.sh cria deploy/.env a partir das suas respostas;
# para preencher à mão: cp deploy/.env.example deploy/.env && chmod 600 deploy/.env
# NUNCA versione deploy/.env (já está no .gitignore). Use aspas simples; não use ' dentro dos valores.

# Domínio do site, sem https:// (o DNS do domínio e do www devem apontar para o IP do servidor).
ARGOS_DOMAIN='argos.exemplo.com.br'

# Segredo das sessões: gere com  openssl rand -base64 48
JWT_SECRET=''

# Administrador inicial. A senha só é usada no primeiro boot (12+ caracteres, 3 tipos, sem "admin/argos/senha");
# depois de entrar, apague a linha ADMIN_PASSWORD (o instalar.sh faz isso sozinho).
ADMIN_EMAIL='voce@exemplo.com'
ADMIN_PASSWORD=''

# E-mail (obrigatório): confirmação de cadastro, senha esquecida e avisos.
# Gmail: smtp.gmail.com, porta 587, usuário = endereço Gmail, senha = "senha de app" de 16 letras.
# Com domínio próprio, prefira Brevo/Resend com SPF e DKIM (o e-mail não cai no spam).
SMTP_HOST='smtp.gmail.com'
SMTP_PORT='587'
SMTP_USER=''
SMTP_PASS=''
MAIL_FROM='ARGOS <voce@exemplo.com>'

# Opcional: e-mail público de atendimento (aparece no rodapé e em "Como funciona").
SUPPORT_EMAIL=''

# Opcional: centro do mapa (campus) e quantos backups diários manter.
MAP_CENTER_LAT='-23.5505'
MAP_CENTER_LNG='-46.6333'
MAP_ZOOM='16'
BACKUP_KEEP='14'

# Integrações opcionais (vazias = desligadas). Ligue só com aprovação do responsável pela privacidade.
ANTHROPIC_API_KEY=''
DEEPL_API_KEY=''
GOOGLE_CLIENT_ID=''
TURNSTILE_SITE_KEY=''
TURNSTILE_SECRET_KEY=''
